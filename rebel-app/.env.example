# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=https://your-deployed-app-url.com

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/rebel_app"

# Supabase Storage for customer order images
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=order-customizations

# App Security
SESSION_SECRET=a_long_random_secret_string_min_32_chars
