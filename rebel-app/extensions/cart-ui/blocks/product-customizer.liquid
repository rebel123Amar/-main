{% comment %}
  Rebel Custom App — Dynamic Multi-Product Customizer Block
  Supports per-product dynamic configuration:
  1. Via Theme Editor settings (default values for this template)
  2. Via Product Tags (Automatic per-product override):
     - 'custom:1-photo' or '1-photo' -> 1 photo only, hides popout
     - 'custom:2-photos' -> 2 photos only
     - 'custom:4-6-photos' or 'popup-frame' -> 4 to 6 photos + 1 popout
     - 'custom:text-only' -> Only text input (no image upload)
     - 'custom:no-text' -> Only photos (no text input)
     - 'custom:no-popout' -> Hide popout image
     - 'custom:disable' -> Completely hide customizer for normal products
  3. Via Shopify Metafields:
     - product.metafields.custom.min_images
     - product.metafields.custom.max_images
{% endcomment %}

{%- liquid
  assign enable_customizer = true

  # Defaults from Block Settings
  assign enable_text = block.settings.enable_text
  if enable_text == nil
    assign enable_text = true
  endif
  assign text_label = block.settings.heading_text | default: 'Enter Text'
  assign text_placeholder = block.settings.placeholder_text | default: 'Enter Text'
  assign text_required = block.settings.text_required | default: false

  assign enable_images = block.settings.enable_images
  if enable_images == nil
    assign enable_images = true
  endif
  assign images_label = block.settings.heading_collage | default: 'Select (4-6) Images'
  assign min_images = block.settings.min_images | default: 4
  assign max_images = block.settings.max_images | default: 6

  assign enable_popout = block.settings.enable_popout
  if enable_popout == nil
    assign enable_popout = true
  endif
  assign popout_label = block.settings.heading_popout | default: 'Select 1 Pop-Out Image'
  assign popout_required = block.settings.popout_required
  if popout_required == nil
    assign popout_required = true
  endif

  # App Customizer Metafield Override (from rebel-custom-app admin interface)
  assign rebel_cfg = product.metafields.rebel_customizer.config.value
  assign has_custom_config = false

  if rebel_cfg != blank
    assign has_custom_config = true
    if rebel_cfg.enabled == false
      assign enable_customizer = false
    else
      assign enable_customizer = true
      if rebel_cfg.enableText != nil
        assign enable_text = rebel_cfg.enableText
      endif
      if rebel_cfg.textLabel != blank
        assign text_label = rebel_cfg.textLabel
      endif
      if rebel_cfg.textPlaceholder != blank
        assign text_placeholder = rebel_cfg.textPlaceholder
      endif
      if rebel_cfg.textRequired != nil
        assign text_required = rebel_cfg.textRequired
      endif
      if rebel_cfg.enablePhotos != nil
        assign enable_images = rebel_cfg.enablePhotos
      endif
      if rebel_cfg.photosLabel != blank
        assign images_label = rebel_cfg.photosLabel
      endif
      if rebel_cfg.minPhotos != blank
        assign min_images = rebel_cfg.minPhotos | plus: 0
      endif
      if rebel_cfg.maxPhotos != blank
        assign max_images = rebel_cfg.maxPhotos | plus: 0
      endif
      if rebel_cfg.enablePopout != nil
        assign enable_popout = rebel_cfg.enablePopout
      endif
      if rebel_cfg.popoutLabel != blank
        assign popout_label = rebel_cfg.popoutLabel
      endif
      if rebel_cfg.popoutRequired != nil
        assign popout_required = rebel_cfg.popoutRequired
      endif
    endif
  endif

  # Product Tags Override (Per-Product Flexibility if no metafield)
  assign has_custom_tag = false
  for tag in product.tags
    assign down_tag = tag | downcase | strip

    # Disable customizer on standard products
    if down_tag == 'custom:disable' or down_tag == 'custom:disabled' or down_tag == 'no-custom' or down_tag == 'customizer:disabled'
      assign enable_customizer = false
      assign has_custom_tag = true
    endif

    # 1 Photo Product (e.g. Mug, Keychain, Wallet Card, Acrylic Plaque)
    if down_tag == 'custom:1-photo' or down_tag == 'custom:single-photo' or down_tag == 'custom:photos:1' or down_tag == '1-photo' or down_tag == 'single-photo'
      assign has_custom_tag = true
      unless has_custom_config
        assign enable_images = true
        assign images_label = 'Upload Your Photo'
        assign min_images = 1
        assign max_images = 1
        assign enable_popout = false
        assign popout_required = false
      endunless
    endif

    # 2 Photos Product (e.g. Double sided keychain, couple frame)
    if down_tag == 'custom:2-photos' or down_tag == 'custom:photos:2' or down_tag == '2-photos'
      assign has_custom_tag = true
      unless has_custom_config
        assign enable_images = true
        assign images_label = 'Upload 2 Photos'
        assign min_images = 2
        assign max_images = 2
        assign enable_popout = false
        assign popout_required = false
      endunless
    endif

    # 3 Photos Product
    if down_tag == 'custom:3-photos' or down_tag == 'custom:photos:3' or down_tag == '3-photos'
      assign has_custom_tag = true
      unless has_custom_config
        assign enable_images = true
        assign images_label = 'Upload 3 Photos'
        assign min_images = 3
        assign max_images = 3
        assign enable_popout = false
        assign popout_required = false
      endunless
    endif

    # 4 to 6 Photos Pop Up Frame
    if down_tag == 'custom:4-6-photos' or down_tag == 'custom:popup-frame' or down_tag == 'popup-frame' or down_tag == '4-6-photos'
      assign has_custom_tag = true
      unless has_custom_config
        assign enable_images = true
        assign images_label = 'Select (4-6) Images'
        assign min_images = 4
        assign max_images = 6
        assign enable_popout = true
        assign popout_required = true
      endunless
    endif

    # Text Only (e.g. Name necklace, engraved ring, bracelet)
    if down_tag == 'custom:text-only' or down_tag == 'text-only' or down_tag == 'custom:engraving'
      assign has_custom_tag = true
      unless has_custom_config
        assign enable_text = true
        assign text_required = true
        assign enable_images = false
        assign enable_popout = false
        assign popout_required = false
      endunless
    endif

    # No Text Field (only photo uploads)
    if down_tag == 'custom:no-text' or down_tag == 'no-text'
      assign has_custom_tag = true
      unless has_custom_config
        assign enable_text = false
      endunless
    endif

    # No Popout Field
    if down_tag == 'custom:no-popout' or down_tag == 'no-popout'
      assign has_custom_tag = true
      unless has_custom_config
        assign enable_popout = false
        assign popout_required = false
      endunless
    endif
  endfor

  # If product is neither configured in app nor tagged, check default rule:
  # If block.settings.auto_enable_all is false, hide customizer on unconfigured products
  assign auto_enable = block.settings.auto_enable_all
  if auto_enable == nil
    assign auto_enable = true
  endif

  if has_custom_config == false and has_custom_tag == false and auto_enable == false
    assign enable_customizer = false
  endif

  # Generic Metafields overrides (fallback)
  if product.metafields.custom.min_images != blank and has_custom_config == false
    assign min_images = product.metafields.custom.min_images | plus: 0
  endif
  if product.metafields.custom.max_images != blank and has_custom_config == false
    assign max_images = product.metafields.custom.max_images | plus: 0
  endif
  if product.metafields.custom.enable_text != blank and has_custom_config == false
    assign enable_text = product.metafields.custom.enable_text
  endif
  if product.metafields.custom.enable_popout != blank and has_custom_config == false
    assign enable_popout = product.metafields.custom.enable_popout
  endif
-%}

{%- if enable_customizer -%}
  {{ 'product-customizer.css' | asset_url | stylesheet_tag }}

  <div
    class="rebel-product-customizer"
    data-app-url="{{ block.settings.app_url | default: 'https://mature-incident-slot-colours.trycloudflare.com' | escape }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-enable-text="{{ enable_text }}"
    data-text-label="{{ text_label | escape }}"
    data-text-required="{{ text_required }}"
    data-enable-images="{{ enable_images }}"
    data-images-label="{{ images_label | escape }}"
    data-min-images="{{ min_images }}"
    data-max-images="{{ max_images }}"
    data-enable-popout="{{ enable_popout }}"
    data-popout-label="{{ popout_label | escape }}"
    data-popout-required="{{ popout_required }}"
  >
    <!-- Error notification banner -->
    <div class="rebel-pc-error-banner" role="alert" style="display:none;">
      <span class="rebel-pc-error-text"></span>
    </div>

    <!-- Status message during upload -->
    <div class="rebel-pc-status" role="status" style="display:none;">
      <div class="rebel-pc-spinner"></div>
      <span class="rebel-pc-status-text">Uploading photos to cloud...</span>
    </div>

    <!-- 1. Text Field (Conditional) -->
    {%- if enable_text -%}
      <div class="rebel-pc-field-group rebel-pc-text-group">
        <label class="rebel-pc-label" for="rebel-pc-text-input">
          <span>{{ text_label }}<span class="req" style="{% unless text_required %}display:none;{% endunless %}">*</span></span>
        </label>
        <input
          type="text"
          id="rebel-pc-text-input"
          class="rebel-pc-input-text"
          placeholder="{{ text_placeholder }}"
          autocomplete="off"
        />
      </div>
    {%- endif -%}

    <!-- 2. Images Upload Dropzone (Conditional) -->
    {%- if enable_images -%}
      <div class="rebel-pc-field-group rebel-pc-images-group">
        <label class="rebel-pc-label">
          <span>{{ images_label }}<span class="req">*</span></span>
          <span class="counter" id="rebel-pc-collage-counter">(0 selected)</span>
        </label>
        <div class="rebel-pc-dropzone" id="rebel-pc-collage-drop" tabindex="0" role="button">
          <input
            type="file"
            id="rebel-pc-collage-input"
            accept="image/jpeg,image/png,image/webp,image/jpg"
            {% if max_images > 1 %}multiple{% endif %}
            aria-label="{{ images_label }}"
          />
          <div class="rebel-pc-dropzone-content">
            <span>Drag & Drop your {% if max_images == 1 %}photo{% else %}files{% endif %} or <span class="browse-link">Browse</span></span>
          </div>
        </div>
        <div class="rebel-pc-thumbnails" id="rebel-pc-collage-thumbs"></div>
      </div>
    {%- endif -%}

    <!-- 3. Pop-Out / Secondary Image Dropzone (Conditional) -->
    {%- if enable_popout -%}
      <div class="rebel-pc-field-group rebel-pc-popout-group">
        <label class="rebel-pc-label">
          <span>{{ popout_label }}<span class="req">{% if popout_required %}*{% endif %}</span></span>
        </label>
        <div class="rebel-pc-dropzone" id="rebel-pc-popout-drop" tabindex="0" role="button">
          <input
            type="file"
            id="rebel-pc-popout-input"
            accept="image/jpeg,image/png,image/webp,image/jpg"
            aria-label="{{ popout_label }}"
          />
          <div class="rebel-pc-dropzone-content">
            <span>Drag & Drop your file or <span class="browse-link">Browse</span></span>
          </div>
        </div>
        <div class="rebel-pc-thumbnails" id="rebel-pc-popout-thumbs"></div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product Image Customizer",
  "target": "section",
  "templates": ["product"],
  "javascript": "product-customizer.js",
  "stylesheet": "product-customizer.css",
  "settings": [
    {
      "type": "header",
      "content": "Backend & Cloud Config"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "Backend App URL",
      "default": "https://mature-incident-slot-colours.trycloudflare.com"
    },
    {
      "type": "header",
      "content": "Product Visibility Rules"
    },
    {
      "type": "checkbox",
      "id": "auto_enable_all",
      "label": "Show on unconfigured products",
      "info": "If disabled, customizer will ONLY show on products that are configured in the Rebel App or tagged.",
      "default": true
    },
    {
      "type": "header",
      "content": "1. Text Input Field"
    },
    {
      "type": "checkbox",
      "id": "enable_text",
      "label": "Enable Text Input",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Text Field Label",
      "default": "Enter Text"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Text Field Placeholder",
      "default": "Enter Text"
    },
    {
      "type": "checkbox",
      "id": "text_required",
      "label": "Make Text Mandatory",
      "default": false
    },
    {
      "type": "header",
      "content": "2. Main Photo / Collage Upload"
    },
    {
      "type": "checkbox",
      "id": "enable_images",
      "label": "Enable Photo Upload",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_collage",
      "label": "Images Field Label",
      "default": "Select (4-6) Images"
    },
    {
      "type": "number",
      "id": "min_images",
      "label": "Minimum Images Required",
      "default": 4
    },
    {
      "type": "number",
      "id": "max_images",
      "label": "Maximum Images Allowed",
      "default": 6
    },
    {
      "type": "header",
      "content": "3. Pop-Out / Secondary Photo Upload"
    },
    {
      "type": "checkbox",
      "id": "enable_popout",
      "label": "Enable Pop-Out Image",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_popout",
      "label": "Pop-Out Image Label",
      "default": "Select 1 Pop-Out Image"
    },
    {
      "type": "checkbox",
      "id": "popout_required",
      "label": "Make Pop-Out Mandatory",
      "default": true
    }
  ]
}
{% endschema %}
