{% comment %}
  Rebel Custom App — Product Page Customizer Block
  Target: section (Dawn Theme compatible, placed on Product page)
  Replicates Mosambi Media's Pop-up Frame customization flow:
  - Enter Text
  - Select (4-6) Images
  - Select 1 Pop-Out Image
  - Validates before Add to Cart ("bina image dale add to cart nahi hoga")
  - Attaches uploaded image URLs as line item properties in cart
{% endcomment %}

{{ 'product-customizer.css' | asset_url | stylesheet_tag }}

<div
  class="rebel-product-customizer"
  data-app-url="{{ block.settings.app_url | default: 'https://separation-merchants-lectures-airfare.trycloudflare.com' | escape }}"
  data-product-title="{{ product.title | escape }}"
  data-shop="{{ shop.permanent_domain | escape }}"
>
  <!-- Error notification banner -->
  <div class="rebel-pc-error-banner" role="alert">
    <span class="rebel-pc-error-text"></span>
  </div>

  <!-- Status message during upload -->
  <div class="rebel-pc-status" role="status">
    <div class="rebel-pc-spinner"></div>
    <span class="rebel-pc-status-text">Uploading photos to cloud...</span>
  </div>

  <!-- 1. Enter Text -->
  <div class="rebel-pc-field-group rebel-pc-text-group">
    <label class="rebel-pc-label" for="rebel-pc-text-input">
      <span>{{ block.settings.heading_text | default: 'Enter Text' }}<span class="req" style="display:none;">*</span></span>
    </label>
    <input
      type="text"
      id="rebel-pc-text-input"
      class="rebel-pc-input-text"
      placeholder="{{ block.settings.placeholder_text | default: 'Enter Text' }}"
      autocomplete="off"
    />
  </div>

  <!-- 2. Select (4-6) Images -->
  <div class="rebel-pc-field-group">
    <label class="rebel-pc-label">
      <span>{{ block.settings.heading_collage | default: 'Select (4-6) Images' }}<span class="req">*</span></span>
      <span class="counter" id="rebel-pc-collage-counter">(0 selected)</span>
    </label>
    <div class="rebel-pc-dropzone" id="rebel-pc-collage-drop" tabindex="0" role="button">
      <input
        type="file"
        id="rebel-pc-collage-input"
        accept="image/jpeg,image/png,image/webp,image/jpg"
        multiple
        aria-label="Upload collage images"
      />
      <div class="rebel-pc-dropzone-content">
        <span>Drag & Drop your files or <span class="browse-link">Browse</span></span>
      </div>
    </div>
    <div class="rebel-pc-thumbnails" id="rebel-pc-collage-thumbs"></div>
  </div>

  <!-- 3. Select 1 Pop-Out Image -->
  <div class="rebel-pc-field-group">
    <label class="rebel-pc-label">
      <span>{{ block.settings.heading_popout | default: 'Select 1 Pop-Out Image' }}<span class="req">*</span></span>
    </label>
    <div class="rebel-pc-dropzone" id="rebel-pc-popout-drop" tabindex="0" role="button">
      <input
        type="file"
        id="rebel-pc-popout-input"
        accept="image/jpeg,image/png,image/webp,image/jpg"
        aria-label="Upload pop-out image"
      />
      <div class="rebel-pc-dropzone-content">
        <span>Drag & Drop your files or <span class="browse-link">Browse</span></span>
      </div>
    </div>
    <div class="rebel-pc-thumbnails" id="rebel-pc-popout-thumbs"></div>
  </div>
</div>

{% schema %}
{
  "name": "Product Image Customizer",
  "target": "section",
  "templates": ["product"],
  "javascript": "product-customizer.js",
  "stylesheet": "product-customizer.css",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "Backend App URL",
      "default": "https://separation-merchants-lectures-airfare.trycloudflare.com"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Text Field Label",
      "default": "Enter Text"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Text Field Placeholder",
      "default": "Enter Text"
    },
    {
      "type": "text",
      "id": "heading_collage",
      "label": "Collage Images Label",
      "default": "Select (4-6) Images"
    },
    {
      "type": "text",
      "id": "heading_popout",
      "label": "Pop-Out Image Label",
      "default": "Select 1 Pop-Out Image"
    }
  ]
}
{% endschema %}
