{% schema %}
{
  "name": "Floating WhatsApp Bounce",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable Button",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_link",
      "label": "WhatsApp Link",
      "default": "https://wa.me/919999999999"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Button Position",
      "options": [
        { "value": "left", "label": "Bottom Left" },
        { "value": "right", "label": "Bottom Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "bottom_space",
      "label": "Bottom Spacing (px)",
      "min": 10,
      "max": 120,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "side_space",
      "label": "Side Spacing Desktop (px)",
      "min": 6,
      "max": 120,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "side_space_mobile",
      "label": "Side Spacing Mobile (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "size",
      "label": "Button Size Desktop (px)",
      "min": 44,
      "max": 100,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "size_mobile",
      "label": "Button Size Mobile (px)",
      "min": 38,
      "max": 70,
      "step": 2,
      "default": 48
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Button Color",
      "default": "#25D366"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation Type",
      "options": [
        { "value": "bounce", "label": "Bounce (Up–Down)" },
        { "value": "pop", "label": "Pop + Bounce" },
        { "value": "none", "label": "None" }
      ],
      "default": "bounce"
    }
  ],
  "presets": [
    {
      "name": "Floating WhatsApp Bounce"
    }
  ]
}
{% endschema %}

{% if section.settings.enable %}
<style>
#wa-bounce-{{ section.id }} {
  position: fixed !important;
  bottom: {{ section.settings.bottom_space | default: 24 }}px !important;
  left: {{ section.settings.side_space | default: 16 }}px !important;
  right: auto !important;
  z-index: 99999999 !important;
}

#wa-bounce-{{ section.id }}.left,
#wa-bounce-{{ section.id }}.right {
  left: {{ section.settings.side_space | default: 16 }}px !important;
  right: auto !important;
}

#wa-bounce-{{ section.id }} a {
  width: {{ section.settings.size | default: 60 }}px;
  height: {{ section.settings.size | default: 60 }}px;
  background: {{ section.settings.bg_color | default: '#25D366' }};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 28px rgba(0,0,0,0.3);
  text-decoration: none;
}

#wa-bounce-{{ section.id }} img {
  width: 55%;
  height: 55%;
}

/* Animations */
.bounce {
  animation: bounceUpDown 1.8s infinite;
}

.pop {
  animation: popBounce 2.2s infinite;
}

@keyframes bounceUpDown {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14px); }
}

@keyframes popBounce {
  0% { transform: scale(1) translateY(0); }
  30% { transform: scale(1.1) translateY(-16px); }
  60% { transform: scale(1) translateY(0); }
  100% { transform: scale(1); }
}

/* Mobile: Push all the way to extreme left edge & compact size so words are never blocked */
@media screen and (max-width: 768px) {
  #wa-bounce-{{ section.id }},
  #wa-bounce-{{ section.id }}.left,
  #wa-bounce-{{ section.id }}.right {
    left: {{ section.settings.side_space_mobile | default: 8 }}px !important;
    right: auto !important;
    bottom: {{ section.settings.bottom_space | default: 20 }}px !important;
  }

  #wa-bounce-{{ section.id }} a {
    width: {{ section.settings.size_mobile | default: 48 }}px !important;
    height: {{ section.settings.size_mobile | default: 48 }}px !important;
    box-shadow: 0 8px 20px rgba(0,0,0,0.28) !important;
  }
}
</style>

<div
  id="wa-bounce-{{ section.id }}"
  class="left"
>
  <a
    href="{{ section.settings.whatsapp_link }}"
    target="_blank"
    class="{{ section.settings.animation | default: 'bounce' }}"
    aria-label="Chat on WhatsApp"
  >
    <img
      src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg"
      alt="WhatsApp"
    >
  </a>
</div>
{% endif %}
