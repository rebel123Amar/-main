{% doc %}
  @prompt
    Create Mosambi Media's signature "Watch & Buy" Video Testimonials / Reels section for Shopify:
    - Vertical video reels slider (9:16 aspect ratio).
    - Lightweight IntersectionObserver for auto-playing muted videos when visible in viewport.
    - Product card docked beneath each video:
      - Product thumbnail
      - Product title
      - Price & compare-at price
      - Green discount badge (e.g., "31% OFF")
      - Full-width "SHOP NOW" CTA button.
    - Touch swipe for mobile and next/previous arrows for desktop.
    - Fully editable via Shopify Theme Customizer with block presets.
{% enddoc %}

{%- assign sec_id = section.id | replace: '_', '' | downcase -%}

{% style %}
  #rebel-watch-buy-{{ sec_id }} {
    --sec-bg: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg }};
    --title-color: {{ section.settings.title_color }};
    --btn-bg: {{ section.settings.button_bg }};
    --btn-text: {{ section.settings.button_text_color }};
    --discount-color: #057805;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;

    background-color: var(--sec-bg);
    padding: var(--padding-top) 0 var(--padding-bottom) 0;
    position: relative;
    overflow: hidden;
    font-family: inherit;
  }

  .rebel-wb__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .rebel-wb__header {
    text-align: center;
    margin-bottom: 28px;
  }

  .rebel-wb__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.05);
    color: var(--title-color);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 50px;
    margin-bottom: 10px;
  }

  .rebel-wb__title {
    font-size: {{ section.settings.title_size_desktop }}px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 8px 0;
    color: var(--title-color);
  }

  .rebel-wb__subtitle {
    font-size: 15px;
    color: #666666;
    margin: 0;
  }

  /* Carousel */
  .rebel-wb__slider-wrapper {
    position: relative;
    padding: 10px 0 20px 0;
  }

  .rebel-wb__track-wrap {
    overflow: hidden;
    padding: 4px;
  }

  .rebel-wb__track {
    display: flex;
    gap: 20px;
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    cursor: grab;
    user-select: none;
  }

  .rebel-wb__track:active {
    cursor: grabbing;
  }

  /* Reel Card */
  .rebel-wb__slide {
    flex: 0 0 calc((100% - (({{ section.settings.columns_desktop }} - 1) * 20px)) / {{ section.settings.columns_desktop }});
    box-sizing: border-box;
    background: var(--card-bg);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .rebel-wb__slide:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.12);
  }

  /* Video wrapper */
  .rebel-wb__video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 14;
    background: #000000;
    overflow: hidden;
  }

  .rebel-wb__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
  }

  .rebel-wb__play-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }

  .rebel-wb__play-badge svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    margin-left: 2px;
  }

  /* Product details docked underneath */
  .rebel-wb__product-info {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--card-bg);
    flex-grow: 1;
    justify-content: space-between;
  }

  .rebel-wb__product-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rebel-wb__product-thumb {
    width: 58px;
    height: 58px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .rebel-wb__product-meta {
    flex: 1;
    min-width: 0;
  }

  .rebel-wb__product-title {
    font-size: 14px;
    font-weight: 700;
    color: #111111;
    margin: 0 0 4px 0;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    display: block;
  }

  .rebel-wb__product-title:hover {
    color: #000000;
    text-decoration: underline;
  }

  .rebel-wb__price-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
  }

  .rebel-wb__price {
    font-weight: 700;
    color: #111111;
  }

  .rebel-wb__compare-price {
    text-decoration: line-through;
    color: #888888;
    font-size: 12px;
  }

  .rebel-wb__discount-badge {
    background: transparent;
    border: 1.5px solid var(--discount-color);
    border-radius: 4px;
    font-weight: 700;
    padding: 2px 6px;
    font-size: 11px;
    color: var(--discount-color);
    letter-spacing: 0.2px;
  }

  .rebel-wb__shop-btn {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--btn-bg);
    color: var(--btn-text);
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-sizing: border-box;
  }

  .rebel-wb__shop-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Arrows */
  .rebel-wb__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 18px;
  }

  .rebel-wb__arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--card-bg);
    border: 1px solid rgba(0, 0, 0, 0.12);
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.2s ease;
  }

  .rebel-wb__arrow:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
  }

  .rebel-wb__arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .rebel-wb__dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rebel-wb__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.15);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.25s ease;
  }

  .rebel-wb__dot.active {
    width: 24px;
    border-radius: 10px;
    background: #000000;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .rebel-wb__slide {
      flex: 0 0 calc((100% - (({{ section.settings.columns_tablet }} - 1) * 16px)) / {{ section.settings.columns_tablet }});
    }
  }

  @media (max-width: 768px) {
    .rebel-wb__title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }

    .rebel-wb__slide {
      flex: 0 0 82%;
    }
  }
{% endstyle %}

<section
  id="rebel-watch-buy-{{ sec_id }}"
  class="rebel-wb"
  aria-label="Watch & Buy Customer Videos"
>
  <div class="rebel-wb__container">
    
    <div class="rebel-wb__header">
      {%- if section.settings.kicker_text != blank -%}
        <div class="rebel-wb__badge">
          <span>{{ section.settings.kicker_text | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="rebel-wb__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="rebel-wb__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="rebel-wb__slider-wrapper">
      <div class="rebel-wb__track-wrap" id="rebel-wb-wrap-{{ sec_id }}">
        <div class="rebel-wb__track" id="rebel-wb-track-{{ sec_id }}">
          
          {%- for block in section.blocks -%}
            <div class="rebel-wb__slide" {{ block.shopify_attributes }}>
              
              {%- comment -%} Video player {%- endcomment -%}
              <div class="rebel-wb__video-wrap">
                {%- if block.settings.video_url != blank -%}
                  <video
                    class="rebel-wb__video"
                    src="{{ block.settings.video_url }}"
                    poster="{{ block.settings.video_poster | image_url: width: 600 }}"
                    playsinline
                    muted
                    loop
                    preload="metadata"
                  ></video>
                {%- elsif block.settings.shopify_video != blank -%}
                  {{ block.settings.shopify_video | video_tag: class: 'rebel-wb__video', playsinline: true, muted: true, loop: true, controls: false }}
                {%- else -%}
                  <video
                    class="rebel-wb__video"
                    src="https://cdn.shopify.com/videos/c/o/v/01fb7c2a1003416c9b1fee8433019a6c.mp4"
                    playsinline
                    muted
                    loop
                  ></video>
                {%- endif -%}

                <div class="rebel-wb__play-badge">
                  <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>

              {%- comment -%} Product info & Shop button {%- endcomment -%}
              <div class="rebel-wb__product-info">
                <div class="rebel-wb__product-top">
                  {%- if block.settings.product_image != blank -%}
                    <img
                      class="rebel-wb__product-thumb"
                      src="{{ block.settings.product_image | image_url: width: 120 }}"
                      alt="{{ block.settings.product_title | escape }}"
                      loading="lazy"
                      width="58"
                      height="58"
                    />
                  {%- endif -%}

                  <div class="rebel-wb__product-meta">
                    <a
                      href="{{ block.settings.product_url | default: '#' }}"
                      class="rebel-wb__product-title"
                      title="{{ block.settings.product_title | escape }}"
                    >
                      {{ block.settings.product_title | default: "Customized Gift Item" }}
                    </a>

                    <div class="rebel-wb__price-wrap">
                      {%- if block.settings.compare_price != blank -%}
                        <span class="rebel-wb__compare-price">{{ block.settings.compare_price }}</span>
                      {%- endif -%}
                      <span class="rebel-wb__price">{{ block.settings.price | default: "Rs. 389.00" }}</span>
                      {%- if block.settings.discount_text != blank -%}
                        <span class="rebel-wb__discount-badge">{{ block.settings.discount_text }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

                <a
                  href="{{ block.settings.product_url | default: '#' }}"
                  class="rebel-wb__shop-btn"
                >
                  {{ block.settings.button_text | default: "SHOP NOW" }}
                </a>
              </div>

            </div>
          {%- endfor -%}

        </div>
      </div>

      <div class="rebel-wb__nav">
        <button
          type="button"
          class="rebel-wb__arrow"
          id="rebel-wb-prev-{{ sec_id }}"
          aria-label="Previous Reel"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="rebel-wb__dots" id="rebel-wb-dots-{{ sec_id }}"></div>

        <button
          type="button"
          class="rebel-wb__arrow"
          id="rebel-wb-next-{{ sec_id }}"
          aria-label="Next Reel"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

    </div>

  </div>
</section>

<script>
  (function() {
    const secId = "{{ sec_id }}";
    const track = document.getElementById("rebel-wb-track-" + secId);
    const prevBtn = document.getElementById("rebel-wb-prev-" + secId);
    const nextBtn = document.getElementById("rebel-wb-next-" + secId);
    const dotsContainer = document.getElementById("rebel-wb-dots-" + secId);
    const slides = track ? Array.from(track.querySelectorAll(".rebel-wb__slide")) : [];

    if (!track || slides.length === 0) return;

    let currentIndex = 0;
    const totalSlides = slides.length;

    function getVisibleCount() {
      const w = window.innerWidth;
      if (w <= 768) return 1;
      if (w <= 1024) return {{ section.settings.columns_tablet | default: 2 }};
      return {{ section.settings.columns_desktop | default: 4 }};
    }

    function getMaxIndex() {
      return Math.max(0, totalSlides - getVisibleCount());
    }

    function buildDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = "";
      const maxIdx = getMaxIndex();
      for (let i = 0; i <= maxIdx; i++) {
        const dot = document.createElement("button");
        dot.className = "rebel-wb__dot" + (i === currentIndex ? " active" : "");
        dot.setAttribute("aria-label", "Go to reel " + (i + 1));
        dot.addEventListener("click", () => goToSlide(i));
        dotsContainer.appendChild(dot);
      }
    }

    function updateDots() {
      if (!dotsContainer) return;
      const dots = dotsContainer.querySelectorAll(".rebel-wb__dot");
      dots.forEach((dot, idx) => {
        dot.classList.toggle("active", idx === currentIndex);
      });
    }

    function updateArrows() {
      const maxIdx = getMaxIndex();
      if (prevBtn) prevBtn.disabled = currentIndex === 0;
      if (nextBtn) nextBtn.disabled = currentIndex >= maxIdx;
    }

    function goToSlide(index) {
      const maxIdx = getMaxIndex();
      currentIndex = Math.min(Math.max(0, index), maxIdx);

      const slide = slides[0];
      if (!slide) return;
      const rect = slide.getBoundingClientRect();
      const style = window.getComputedStyle(track);
      const gap = parseFloat(style.gap) || 20;
      const step = rect.width + gap;

      track.style.transform = "translateX(-" + (currentIndex * step) + "px)";
      updateDots();
      updateArrows();
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => goToSlide(currentIndex - 1));
    }
    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        const maxIdx = getMaxIndex();
        if (currentIndex >= maxIdx) {
          goToSlide(0);
        } else {
          goToSlide(currentIndex + 1);
        }
      });
    }

    // Touch swipe
    let startX = 0;
    let isDragging = false;

    track.addEventListener("touchstart", (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    }, { passive: true });

    track.addEventListener("touchend", (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) goToSlide(currentIndex + 1);
        else goToSlide(currentIndex - 1);
      }
    });

    // Auto play videos when in viewport (IntersectionObserver)
    const videos = track.querySelectorAll(".rebel-wb__video");
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target;
          if (entry.isIntersecting) {
            video.muted = true;
            const promise = video.play();
            if (promise !== undefined) {
              promise.catch(() => {});
            }
          } else {
            video.pause();
          }
        });
      }, { threshold: 0.4 });

      videos.forEach(v => observer.observe(v));
    }

    // Toggle mute/play on video click
    videos.forEach(video => {
      video.addEventListener("click", () => {
        if (video.paused) {
          video.play();
        } else {
          video.muted = !video.muted;
        }
      });
    });

    buildDots();
    goToSlide(0);

    let resizeTimer;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        buildDots();
        goToSlide(currentIndex);
      }, 150);
    });
  })();
</script>

