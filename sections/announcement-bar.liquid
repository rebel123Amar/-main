{% doc %}
  @prompt
    Create a Shopify announcement bar section with the following exact specifications:
    
    - Full-width horizontal announcement bar.
    - Background: pure black (#000000).
    - Text: white, bold, clean and easy to read.
    - Font size around 14–16px on desktop.
    - Single horizontal line, center-align all content vertically.
    - Add a glowing white 4-point sparkle/star icon (✦) between every message.
    - Keep equal spacing between each message and sparkle.
    - The announcement bar should continuously auto-scroll/marquee from right to left.
    - Animation should be smooth, seamless, and loop infinitely with no visible gap when the animation restarts.
    - Hide the scrollbar.
    - On mobile, keep the same single-line horizontal scrolling behavior.
    - Do not wrap the text into multiple lines.
    - Pause animation on hover.
    
    ANNOUNCEMENT TEXT (each editable from Theme Editor as separate text settings):
    1. "Trusted by 5L+ Happy Customers"
    2. "Unique Personalized Gifts"
    3. "Estimated Delivery 5-7 Working Days"
    4. "Free shipping above order ₹699"
    
    Each message separated by a glowing white 4-point sparkle ✦.
    
    Technical requirements:
    - Use Shopify Liquid, HTML, CSS and vanilla JavaScript only.
    - No external libraries.
    - Fully responsive.
    - Do not affect other sections of the Shopify theme.
    - Make the marquee smooth and lightweight using CSS animation (translateX).
    - Duplicate the content block to create a seamless infinite loop with no gap.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
    position: relative;
    padding: {{ block.settings.bar_height }}px 0;
  }

  .ai-announcement-bar-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    width: max-content;
    animation: ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-announcement-bar-{{ ai_gen_id }}:hover .ai-announcement-bar-wrapper-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    gap: {{ block.settings.message_spacing }}px;
  }

  .ai-announcement-bar-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: 0.5px;
  }

  .ai-announcement-bar-sparkle-{{ ai_gen_id }} {
    color: {{ block.settings.sparkle_color }};
    font-size: {{ block.settings.sparkle_size }}px;
    display: inline-block;
    animation: ai-sparkle-glow-{{ ai_gen_id }} 2s ease-in-out infinite;
  }

  @keyframes ai-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes ai-sparkle-glow-{{ ai_gen_id }} {
    0%, 100% {
      opacity: 1;
      text-shadow: 0 0 8px {{ block.settings.sparkle_glow_color }}, 0 0 12px {{ block.settings.sparkle_glow_color }};
    }
    50% {
      opacity: 0.8;
      text-shadow: 0 0 4px {{ block.settings.sparkle_glow_color }}, 0 0 6px {{ block.settings.sparkle_glow_color }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-message-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }

    .ai-announcement-bar-sparkle-{{ ai_gen_id }} {
      font-size: {{ block.settings.sparkle_size_mobile }}px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }} class="ai-announcement-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-bar-wrapper-{{ ai_gen_id }}">
    <div class="ai-announcement-bar-content-{{ ai_gen_id }}">
      {% if block.settings.message_1 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_1 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
      {% if block.settings.message_2 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_2 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
      {% if block.settings.message_3 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_3 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
      {% if block.settings.message_4 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_4 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
    </div>
    <div class="ai-announcement-bar-content-{{ ai_gen_id }}">
      {% if block.settings.message_1 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_1 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
      {% if block.settings.message_2 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_2 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
      {% if block.settings.message_3 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_3 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
      {% if block.settings.message_4 != blank %}
        <span class="ai-announcement-bar-message-{{ ai_gen_id }}">{{ block.settings.message_4 }}</span>
      {% endif %}
      <span class="ai-announcement-bar-sparkle-{{ ai_gen_id }}">✦</span>
    </div>
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustScrollSpeed();
      }

      adjustScrollSpeed() {
        const content = this.querySelector('.ai-announcement-bar-content-{{ ai_gen_id }}');
        if (!content) return;

        const contentWidth = content.offsetWidth;
        const wrapper = this.querySelector('.ai-announcement-bar-wrapper-{{ ai_gen_id }}');
        
        if (wrapper && contentWidth > 0) {
          const speed = {{ block.settings.scroll_speed }};
          wrapper.style.animationDuration = speed + 's';
        }
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

